<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/primaryBlackBackground"
    android:maxHeight="600dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tts_settings_title"
            android:textColor="?attr/textColor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/tts_engine"
            android:textColor="?attr/textColor"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tts_engine_system"
                style="@style/BlackButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/tts_engine_system" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tts_engine_ondevice"
                style="@style/BlackButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/tts_engine_on_device" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tts_ondevice_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/tts_model"
                android:textColor="?attr/textColor"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/tts_model_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tts_voice"
                    android:textColor="?attr/textColor"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tts_voice_button"
                    style="@style/BlackButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tts_voice" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/tts_buffer_sentences"
                android:textColor="?attr/textColor"
                android:textSize="15sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/tts_buffer_slider"
                style="@style/SettingsSliderTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:stepSize="1"
                android:value="3"
                android:valueFrom="1"
                android:valueTo="6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/tts_sentence_gap"
                android:textColor="?attr/textColor"
                android:textSize="15sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/tts_gap_slider"
                style="@style/SettingsSliderTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:stepSize="25"
                android:value="150"
                android:valueFrom="0"
                android:valueTo="1000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tts_pregen_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/tts_pregen_manage"
                app:icon="@drawable/ic_baseline_record_voice_over_24"
                app:iconGravity="textStart" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tts_settings_done"
            style="@style/BlackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/done" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
